<%- include('../partials/header') %>

<section class="page-head">
    <h1>Edit Medical File</h1>
    <p class="page-subtitle">Update file naming and category without changing the stored file type.</p>
</section>

<section class="card">
    <form action="/admin/edit/<%= file._id %>" method="POST" class="upload-card">
        <label for="imageName">File Name</label>
        <input
            id="imageName"
            class="file-input"
            type="text"
            name="imageName"
            value="<%= initialName %>"
            required
        >
        <label for="category">Category</label>
        <select id="category" class="file-input" name="category" required>
            <% categories.forEach(category => { %>
                <option value="<%= category %>" <%= category === selectedCategory ? 'selected' : '' %>>
                    <%= category %>
                </option>
            <% }) %>
        </select>
        <div class="actions-group">
            <button type="submit" class="btn btn-primary">Save</button>
            <a href="/admin/dashboard" class="btn btn-secondary">Cancel</a>
        </div>
    </form>
</section>

<%- include('../partials/footer') %>
